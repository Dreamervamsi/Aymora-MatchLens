<file path="frontend/src/components/assessment/ScenarioResponseForm.jsx">
import React, { useState, useEffect } from 'react';
import { CheckCircle2, Send, HelpCircle, AlertCircle } from 'lucide-react';
import { Card, Button } from '../ui';

export const ScenarioResponseForm = ({
  allowedOptions,
  optionDescriptions = {},
  unresolvedClarification,
  submitting,
  onSubmitTurn,
}) => {
  const [selectedOption, setSelectedOption] = useState('');
  const [customInput, setCustomInput] = useState('');
  const [isCustomMode, setIsCustomMode] = useState(false);

  // Reset form when allowed options change (new scenario loaded)
  useEffect(() => {
    setSelectedOption('');
    setCustomInput('');
    setIsCustomMode(false);
  }, [allowedOptions]);

  const handleSubmit = (e) => {
    e.preventDefault();
    if (submitting) return;

    const valueToSubmit = isCustomMode ? customInput.trim() : selectedOption;
    if (!valueToSubmit) return;

    onSubmitTurn(valueToSubmit);
  };

  const handleClarificationChoice = (choice) => {
    if (submitting) return;
    onSubmitTurn(choice);
  };

  // 1. Clarification Required View
  if (unresolvedClarification) {
    const { clarification_prompt, proposed_option, raw_input } = unresolvedClarification;
    const confirmButtonLabel = submitting
      ? 'Confirming...'
      : proposed_option
        ? `Yes, I meant "${proposed_option.replace(/_/g, ' ')}"`
        : 'Yes, that is correct';

    const safePromptText =
      clarification_prompt ||
      (proposed_option
        ? `Did you mean '${proposed_option}'?`
        : 'Please clarify or rephrase your response.');

    return (
      <Card className="p-6 md:p-8 mb-6 border-[#F2C0B6] bg-[#FDF0ED]/30 shadow-sm">
        <div className="flex items-start gap-3 mb-4">
          <div className="w-10 h-10 rounded-xl bg-[#FDF0ED] border border-[#F2C0B6] text-[#E07A5F] flex items-center justify-center shrink-0">
            <HelpCircle className="w-5 h-5" />
          </div>
          <div>
            <h3 className="text-base font-bold text-[#2B2D42]">Clarification Required</h3>
            {raw_input && (
              <p className="text-xs text-[#5C627A] mt-0.5">
                Your previous response: <span className="italic font-medium text-[#2B2D42]">&quot;{raw_input}&quot;</span>
              </p>
            )}
          </div>
        </div>

        <p className="text-sm font-semibold text-[#2B2D42] mb-6 bg-white p-4 rounded-xl border border-[#E8E3DC]">
          {safePromptText}
        </p>

        <div className="flex flex-col sm:flex-row gap-3">
          <Button
            variant="primary"
            icon={CheckCircle2}
            disabled={submitting}
            onClick={() => handleClarificationChoice('yes')}
            className="flex-1"
          >
            {confirmButtonLabel}
          </Button>
          <Button
            variant="secondary"
            disabled={submitting}
            onClick={() => setIsCustomMode(true)}
            className="flex-1"
          >
            No, let me rephrase
          </Button>
        </div>

        {isCustomMode && (
          <form onSubmit={handleSubmit} className="mt-4 pt-4 border-t border-[#E8E3DC]">
            <label className="block text-xs font-semibold text-[#5C627A] mb-2 uppercase tracking-wider">
              Type your intended response:
            </label>
            <div className="flex gap-2">
              <input
                type="text"
                value={customInput}
                onChange={(e) => setCustomInput(e.target.value)}
                placeholder="Type your response..."
                className="flex-1 px-4 py-2.5 rounded-xl border border-[#E8E3DC] text-sm focus:outline-none focus:ring-2 focus:ring-[#E07A5F] focus:border-transparent"
                disabled={submitting}
              />
              <Button variant="primary" icon={Send} disabled={submitting || !customInput.trim()}>
                Submit
              </Button>
            </div>
          </form>
        )}
      </Card>
    );
  }

  // 2. Standard Multiple Choice Option Selection
  return (
    <Card className="p-6 md:p-8 mb-6 border-[#E8E3DC] shadow-sm">
      <form onSubmit={handleSubmit}>
        <h3 className="text-sm font-bold text-[#2B2D42] uppercase tracking-wider mb-4">
          Select the option that best applies:
        </h3>

        <div className="space-y-3 mb-6">
          {allowedOptions && allowedOptions.length > 0 ? (
            allowedOptions.map((optKey) => {
              const isSelected = selectedOption === optKey && !isCustomMode;
              const desc = optionDescriptions[optKey];
              const labelText = optKey.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

              return (
                <div
                  key={optKey}
                  onClick={() => {
                    if (submitting) return;
                    setSelectedOption(optKey);
                    setIsCustomMode(false);
                  }}
                  className={`p-4 rounded-xl border cursor-pointer transition-all duration-200 flex items-start gap-3.5 ${
                    isSelected
                      ? 'border-[#E07A5F] bg-[#FDF0ED] shadow-sm ring-1 ring-[#E07A5F]'
                      : 'border-[#E8E3DC] bg-white hover:border-[#F2C0B6] hover:bg-[#FAF6F0]'
                  }`}
                >
                  <div className="pt-0.5 shrink-0">
                    <div
                      className={`w-5 h-5 rounded-full border flex items-center justify-center transition-colors ${
                        isSelected
                          ? 'border-[#E07A5F] bg-[#E07A5F] text-white'
                          : 'border-[#A0A4B8] bg-white'
                      }`}
                    >
                      {isSelected && <CheckCircle2 className="w-3.5 h-3.5" />}
                    </div>
                  </div>
                  <div className="flex-1">
                    <div className="text-sm font-bold text-[#2B2D42]">{labelText}</div>
                    {desc && <div className="text-xs text-[#5C627A] mt-1 leading-relaxed">{desc}</div>}
                  </div>
                </div>
              );
            })
          ) : (
            <div className="p-4 bg-[#FAF6F0] rounded-xl text-xs text-[#5C627A] flex items-center gap-2">
              <AlertCircle className="w-4 h-4 text-[#E07A5F]" />
              <span>No pre-defined options available. Please type your response below.</span>
            </div>
          )}
        </div>

        {/* Option to type custom natural language response if desired */}
        <div className="mb-6 pt-4 border-t border-[#E8E3DC]/60">
          <button
            type="button"
            onClick={() => setIsCustomMode(!isCustomMode)}
            className="text-xs font-semibold text-[#E07A5F] hover:underline flex items-center gap-1"
          >
            {isCustomMode ? '← Back to option selection' : 'Or respond in your own words...'}
          </button>

          {isCustomMode && (
            <div className="mt-3">
              <textarea
                value={customInput}
                onChange={(e) => setCustomInput(e.target.value)}
                placeholder="Describe how you or your partner would respond in this scenario..."
                rows={3}
                className="w-full p-3.5 rounded-xl border border-[#E8E3DC] text-sm focus:outline-none focus:ring-2 focus:ring-[#E07A5F] focus:border-transparent"
                disabled={submitting}
              />
            </div>
          )}
        </div>

        <Button
          type="submit"
          variant="primary"
          icon={Send}
          disabled={submitting || (isCustomMode ? !customInput.trim() : !selectedOption)}
          className="w-full py-3 shadow-md"
        >
          {submitting ? 'Submitting Response...' : 'Submit Choice & Proceed'}
        </Button>
      </form>
    </Card>
  );
};

export default ScenarioResponseForm;
</file>

<file path="frontend/src/components/assessment/ScenarioReview.jsx">
import React, { useState } from 'react';
import { User, Heart, CheckCircle, Edit3 } from 'lucide-react';
import { Card, Button, Badge } from '../ui';

const KNOWN_TITLE_MAP = {
  conflict_resolution_01: 'Handling disagreement after a stressful day',
  social_energy_01: 'Weekend downtime preferences',
  financial_planning_01: 'Approach to joint budgeting and major expenses',
};

const formatOptionLabel = (str) => {
  if (!str) return 'Not answered';
  return str.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
};

export const ScenarioReview = ({
  summaryData = {},
  selectedScenarioIds = [],
  confirming,
  onConfirmAssessment,
  onCorrectResponse,
  correctingState = {},
  isAlreadyCompleted = false,
  onNavigateToMatches,
}) => {
  const [editingKey, setEditingKey] = useState(null); // `${scenarioId}_${target}`
  const [editValue, setEditValue] = useState('');
  const [correctionError, setCorrectionError] = useState(null);

  const scenarioIds = selectedScenarioIds.length > 0 ? selectedScenarioIds : Object.keys(summaryData);

  const handleStartCorrection = (scenarioId, target, currentValue) => {
    setEditingKey(`${scenarioId}_${target}`);
    setEditValue(currentValue || '');
    setCorrectionError(null);
  };

  const handleSaveCorrection = async (scenarioId, target) => {
    if (!editValue.trim()) return;
    const isCorrectingThis = correctingState[`${scenarioId}_${target}`] || correctingState[scenarioId];
    if (isCorrectingThis) return;

    setCorrectionError(null);
    const result = await onCorrectResponse(scenarioId, target, editValue.trim());

    if (result && result.success === false) {
      setCorrectionError(result.error || 'Correction failed.');
    } else {
      setEditingKey(null);
      setEditValue('');
      setCorrectionError(null);
    }
  };

  return (
    <div className="space-y-6">
      <Card className="p-6 md:p-8 border-[#F2C0B6] bg-[#FDF0ED]/30 shadow-sm">
        <div className="flex items-start gap-4">
          <div className="w-12 h-12 rounded-2xl bg-[#FDF0ED] border border-[#F2C0B6] text-[#E07A5F] flex items-center justify-center shrink-0">
            <CheckCircle className="w-6 h-6" />
          </div>
          <div>
            <Badge variant="rose" className="mb-2">
              All Scenarios Answered
            </Badge>
            <h2 className="text-xl font-bold text-[#2B2D42] tracking-tight">
              Review Your Assessment
            </h2>
            <p className="text-sm text-[#5C627A] mt-1 leading-relaxed">
              Compare your personal behavior against your ideal partner expectations for each scenario before final confirmation.
            </p>
          </div>
        </div>
      </Card>

      {/* Scenario Responses Comparison Cards */}
      {scenarioIds.map((sid, idx) => {
        const scenarioResponses = summaryData[sid] || {};
        const title = KNOWN_TITLE_MAP[sid] || `Scenario ${idx + 1}: ${sid}`;
        const selfResp = scenarioResponses.self_response;
        const partnerResp = scenarioResponses.partner_expectation;

        const isEditingSelf = editingKey === `${sid}_self_behavior`;
        const isEditingPartner = editingKey === `${sid}_partner_expectation`;
        const isCorrectingSelf = correctingState[`${sid}_self_behavior`] || (isEditingSelf && correctingState[sid]);
        const isCorrectingPartner = correctingState[`${sid}_partner_expectation`] || (isEditingPartner && correctingState[sid]);

        return (
          <Card key={sid} className="p-6 md:p-8 border-[#E8E3DC] shadow-sm">
            <div className="flex items-center justify-between pb-4 border-b border-[#E8E3DC]/60 mb-6">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-[#E07A5F]">
                  Scenario {idx + 1}
                </span>
                <h3 className="text-lg font-bold text-[#2B2D42]">{title}</h3>
              </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
              {/* Self Behavior Column */}
              <div className="p-4 rounded-2xl border border-[#F2C0B6] bg-[#FDF0ED]/40">
                <div className="flex items-center justify-between mb-3">
                  <div className="flex items-center gap-2">
                    <User className="w-4 h-4 text-[#E07A5F]" />
                    <span className="text-xs font-bold uppercase tracking-wider text-[#2B2D42]">
                      Your Behavior
                    </span>
                  </div>
                  {!isAlreadyCompleted && !isEditingSelf && (
                    <button
                      type="button"
                      onClick={() => handleStartCorrection(sid, 'self_behavior', selfResp)}
                      className="text-xs font-semibold text-[#E07A5F] hover:underline flex items-center gap-1"
                    >
                      <Edit3 className="w-3 h-3" /> Correct
                    </button>
                  )}
                </div>

                {isEditingSelf ? (
                  <div className="space-y-2 mt-2">
                    <input
                      type="text"
                      value={editValue}
                      onChange={(e) => setEditValue(e.target.value)}
                      placeholder="Type option, e.g. discuss_immediately"
                      className="w-full px-3 py-2 rounded-xl border border-[#E8E3DC] text-xs focus:outline-none focus:ring-2 focus:ring-[#E07A5F]"
                    />
                    {correctionError && (
                      <p className="text-xs text-[#E07A5F]">{correctionError}</p>
                    )}
                    <div className="flex gap-2">
                      <Button
                        size="sm"
                        variant="primary"
                        onClick={() => handleSaveCorrection(sid, 'self_behavior')}
                        disabled={isCorrectingSelf}
                      >
                        {isCorrectingSelf ? 'Saving...' : 'Save'}
                      </Button>
                      <Button
                        size="sm"
                        variant="secondary"
                        onClick={() => {
                          setEditingKey(null);
                          setCorrectionError(null);
                        }}
                      >
                        Cancel
                      </Button>
                    </div>
                  </div>
                ) : (
                  <p className="text-sm font-semibold text-[#2B2D42]">
                    {formatOptionLabel(selfResp)}
                  </p>
                )}
              </div>

              {/* Partner Expectation Column */}
              <div className="p-4 rounded-2xl border border-[#3D5A80]/30 bg-[#3D5A80]/5">
                <div className="flex items-center justify-between mb-3">
                  <div className="flex items-center gap-2">
                    <Heart className="w-4 h-4 text-[#3D5A80]" />
                    <span className="text-xs font-bold uppercase tracking-wider text-[#2B2D42]">
                      Your Ideal Partner
                    </span>
                  </div>
                  {!isAlreadyCompleted && !isEditingPartner && (
                    <button
                      type="button"
                      onClick={() => handleStartCorrection(sid, 'partner_expectation', partnerResp)}
                      className="text-xs font-semibold text-[#3D5A80] hover:underline flex items-center gap-1"
                    >
                      <Edit3 className="w-3 h-3" /> Correct
                    </button>
                  )}
                </div>

                {isEditingPartner ? (
                  <div className="space-y-2 mt-2">
                    <input
                      type="text"
                      value={editValue}
                      onChange={(e) => setEditValue(e.target.value)}
                      placeholder="Type option, e.g. cool_down_first"
                      className="w-full px-3 py-2 rounded-xl border border-[#E8E3DC] text-xs focus:outline-none focus:ring-2 focus:ring-[#3D5A80]"
                    />
                    {correctionError && (
                      <p className="text-xs text-[#E07A5F]">{correctionError}</p>
                    )}
                    <div className="flex gap-2">
                      <Button
                        size="sm"
                        variant="primary"
                        onClick={() => handleSaveCorrection(sid, 'partner_expectation')}
                        disabled={isCorrectingPartner}
                      >
                        {isCorrectingPartner ? 'Saving...' : 'Save'}
                      </Button>
                      <Button
                        size="sm"
                        variant="secondary"
                        onClick={() => {
                          setEditingKey(null);
                          setCorrectionError(null);
                        }}
                      >
                        Cancel
                      </Button>
                    </div>
                  </div>
                ) : (
                  <p className="text-sm font-semibold text-[#2B2D42]">
                    {formatOptionLabel(partnerResp)}
                  </p>
                )}
              </div>
            </div>
          </Card>
        );
      })}

      {/* Confirmation CTA Bar */}
      <div className="pt-6 border-t border-[#E8E3DC] flex flex-col sm:flex-row items-center justify-between gap-4">
        {isAlreadyCompleted ? (
          <Button
            variant="primary"
            icon={CheckCircle}
            onClick={onNavigateToMatches}
            className="w-full sm:w-auto shadow-md"
          >
            Discover My Matches
          </Button>
        ) : (
          <Button
            variant="primary"
            icon={CheckCircle}
            onClick={onConfirmAssessment}
            disabled={confirming}
            className="w-full sm:w-auto py-3.5 px-8 shadow-md"
          >
            {confirming ? 'Confirming Assessment...' : 'Confirm My Assessment'}
          </Button>
        )}
      </div>
    </div>
  );
};

export default ScenarioReview;
</file>

<file path="frontend/src/components/interview/ChatComposer.jsx">
import { useState, useRef, useEffect } from 'react';
import { Send, Loader2 } from 'lucide-react';
import { Button } from '../ui/Button';

/**
 * Sticky chat message composer.
 * Supports multiline input, auto-height resizing, Enter to send, Shift+Enter for newline,
 * double-submission prevention, and draft message retention on failure.
 */
export const ChatComposer = ({
  onSendMessage,
  disabled = false,
  isLoading = false,
  placeholder = 'Type your response here...',
  initialValue = '',
}) => {
  const [message, setMessage] = useState(initialValue);
  const textareaRef = useRef(null);

  useEffect(() => {
    setMessage(initialValue);
  }, [initialValue]);

  // Auto-resize textarea height as user types
  useEffect(() => {
    if (textareaRef.current) {
      textareaRef.current.style.height = 'auto';
      textareaRef.current.style.height = `${Math.min(textareaRef.current.scrollHeight, 140)}px`;
    }
  }, [message]);

  const handleSubmit = (e) => {
    if (e) e.preventDefault();
    const trimmed = message.trim();
    if (!trimmed || disabled || isLoading) return;

    onSendMessage(trimmed);
    setMessage('');
    if (textareaRef.current) {
      textareaRef.current.style.height = 'auto';
    }
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSubmit();
    }
  };

  return (
    <form
      onSubmit={handleSubmit}
      className="bg-white border border-[#E8E3DC] rounded-2xl p-2 sm:p-3 shadow-xs flex items-end gap-2 transition-all focus-within:border-[#E07A5F] focus-within:ring-2 focus-within:ring-[#E07A5F]/10"
    >
      <textarea
        ref={textareaRef}
        rows={1}
        value={message}
        onChange={(e) => setMessage(e.target.value)}
        onKeyDown={handleKeyDown}
        disabled={disabled || isLoading}
        placeholder={placeholder}
        className="flex-1 bg-transparent border-0 text-sm text-[#2B2D42] placeholder-[#A0A4B8] resize-none focus:outline-none p-2 min-h-[40px] max-h-[140px] leading-relaxed disabled:opacity-50"
      />

      <Button
        type="submit"
        size="md"
        disabled={!message.trim() || disabled || isLoading}
        className="shrink-0 rounded-xl px-4 py-2.5"
      >
        {isLoading ? (
          <Loader2 className="w-4 h-4 animate-spin text-white" />
        ) : (
          <Send className="w-4 h-4 text-white" />
        )}
      </Button>
    </form>
  );
};

export default ChatComposer;
</file>

