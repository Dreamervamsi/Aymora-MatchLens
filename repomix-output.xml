    # 4. Verify profile in repository
    prof_res = client.get(f"/api/v1/profiles/{user_id}")
    assert prof_res.status_code == 200

    # 5. Start Scenario Assessment
    scen_start_res = client.post(
        "/api/v1/assessment/start",
