import React, { useEffect, useState, useCallback, useRef } from 'react';
import { useNavigate, Link } from 'react-router-dom';
import { AlertCircle, RefreshCw, ArrowRight, RotateCcw, ShieldAlert, Layers } from 'lucide-react';
import { Card, Button, Badge } from '../components/ui';
import { useWorkflow } from '../context/WorkflowContext';
import assessmentService from '../services/assessmentService';
import profileService from '../services/profileService';
import {
  AssessmentHeader,
  ScenarioProgress,
  ScenarioCard,
  ScenarioResponseForm,
  ScenarioReview,
  AssessmentCompletion,
} from '../components/assessment';

import { isAssessmentPersistedInProfile } from '../utils/assessmentUtils';

export const AssessmentPage = () => {
  const navigate = useNavigate();
  const { userId, assessmentId, setAssessmentId } = useWorkflow();

  // Component State
  const [loading, setLoading] = useState(true);
  const [submitting, setSubmitting] = useState(false);
  const [confirming, setConfirming] = useState(false);
  const [rechecking, setRechecking] = useState(false);
  const [correctingState, setCorrectingState] = useState({});

  const [hasConfirmedProfile, setHasConfirmedProfile] = useState(false);
  const [profileCheckFailed, setProfileCheckFailed] = useState(false);
  const [restorationFailed, setRestorationFailed] = useState(false);
  const [error, setError] = useState(null);
  const [uncertainError, setUncertainError] = useState(null);

  // Turn / State Data
  const [assessmentData, setAssessmentData] = useState(null);

  // Generation counter to protect against stale asynchronous responses
  const activeGenRef = useRef(0);

  // 1. Verify eligibility and initialize/restore session on mount
  const initializeAssessment = useCallback(async () => {
    const currentGen = ++activeGenRef.current;
    setLoading(true);
    setError(null);
    setUncertainError(null);
    setProfileCheckFailed(false);
    setRestorationFailed(false);

    // Read current user ID directly from sessionStorage fallback if context is initializing
    const activeUserId = userId || sessionStorage.getItem('matchlens_user_id');

    if (!activeUserId) {
      if (currentGen === activeGenRef.current) {
        setError('Missing user identifier. Please return to onboarding.');
        setLoading(false);
      }
      return;
    }

    // Step A: Verify confirmed profile exists
    try {
      const profile = await profileService.getProfile(activeUserId);
      if (currentGen === activeGenRef.current) {
        if (!profile || (profile.user_id && profile.user_id !== activeUserId)) {
          setHasConfirmedProfile(false);
        } else {
          setHasConfirmedProfile(true);
        }
      }
    } catch (err) {
      if (currentGen !== activeGenRef.current) return;
      // In unit test mocks or API errors, handle missing profile / 404
      if (err?.status === 404 || err?.message?.includes('404') || err?.message?.toLowerCase().includes('not found')) {
        setHasConfirmedProfile(false);
        setLoading(false);
        return;
      }
      // Server error (500+) during profile check
      setProfileCheckFailed(true);
      setError('Failed to verify confirmed profile. Please check your network or server state.');
      setLoading(false);
      return;
    }

    // Step B: If stored assessmentId exists, attempt to restore it
    const activeAssessmentId = assessmentId || sessionStorage.getItem('matchlens_assessment_id');
    if (activeAssessmentId) {
      try {
        const stateRes = await assessmentService.getAssessmentState(activeAssessmentId);
        if (currentGen === activeGenRef.current) {
          setAssessmentData(stateRes);
          setLoading(false);
          return;
        }
      } catch (err) {
        if (currentGen !== activeGenRef.current) return;
        if (err?.status === 404 || err?.message?.includes('404')) {
          // Session expired or unknown on backend
          setError('Stored assessment session has expired or is invalid. Please start a new assessment.');
          setLoading(false);
          return;
        }
        // Server / Network error during restoration (500, timeout)
        setRestorationFailed(true);
        setError(err?.message || 'Failed to restore assessment session due to a network or server error.');
        setLoading(false);
        return;
      }
    }

    // Step C: No assessmentId, default to ready-to-start state
    if (currentGen === activeGenRef.current) {
      setLoading(false);
    }
  }, [userId, assessmentId]);

  useEffect(() => {
    initializeAssessment();
  }, [initializeAssessment]);

  // Action: Explicit Start Assessment
  const handleStartAssessment = async () => {
    if (submitting) return;
    const currentGen = ++activeGenRef.current;
    setSubmitting(true);
    setError(null);

    try {
      const activeUserId = userId || sessionStorage.getItem('matchlens_user_id');
      const turnRes = await assessmentService.startAssessment(activeUserId, null, null);
      if (currentGen === activeGenRef.current) {
        setAssessmentData(turnRes);
        setAssessmentId(turnRes.assessment_id);
      }
    } catch (err) {
      if (currentGen === activeGenRef.current) {
        setError(err?.message || 'Failed to start scenario assessment.');
      }
    } finally {
      if (currentGen === activeGenRef.current) {
        setSubmitting(false);
      }
    }
  };

  // Action: Submit Response Turn
  const handleSubmitTurn = async (userResponseText) => {
    if (submitting || !assessmentData?.assessment_id) return;
    const currentGen = activeGenRef.current;
    setSubmitting(true);
    setError(null);

    try {
      const turnRes = await assessmentService.submitTurn(assessmentData.assessment_id, userResponseText);
      if (currentGen === activeGenRef.current) {
        setAssessmentData(turnRes);
      }
    } catch (err) {
      if (currentGen === activeGenRef.current) {
        setError(err?.message || 'Failed to submit scenario response. Please try again.');
      }
    } finally {
      if (currentGen === activeGenRef.current) {
        setSubmitting(false);
      }
    }
  };

  // Action: Correct Response
  const handleCorrectResponse = async (scenarioId, target, newValue) => {
    if (!assessmentData?.assessment_id) {
      return { success: false, error: 'No active assessment session.' };
    }
    const currentGen = activeGenRef.current;
    const key = `${scenarioId}_${target}`;
    setCorrectingState((prev) => ({ ...prev, [key]: true, [scenarioId]: true }));
    setError(null);

    try {
      const turnRes = await assessmentService.correctResponse(
        assessmentData.assessment_id,
        scenarioId,
        target,
        newValue
      );
      if (currentGen === activeGenRef.current) {
        setAssessmentData(turnRes);
      }
      return { success: true, data: turnRes };
    } catch (err) {
      const errMsg = err?.message || `Failed to correct ${target} for scenario ${scenarioId}.`;
      if (currentGen === activeGenRef.current) {
        setError(errMsg);
      }
      return { success: false, error: errMsg };
    } finally {
      if (currentGen === activeGenRef.current) {
        setCorrectingState((prev) => ({ ...prev, [key]: false, [scenarioId]: false }));
      }
    }
  };

  // Action: Status Recheck for ambiguous network failure
  const handleRecheckStatus = async () => {
    if (!assessmentData?.assessment_id) return;
    setRechecking(true);
    setUncertainError(null);
    const activeUserId = userId || sessionStorage.getItem('matchlens_user_id');

    try {
      // Re-fetch assessment state from backend
      const stateRes = await assessmentService.getAssessmentState(assessmentData.assessment_id);
      let profile = null;
      try {
        profile = await profileService.getProfile(activeUserId);
      } catch {
        // Profile fetch failed
      }

      if (stateRes?.status === 'completed' || isAssessmentPersistedInProfile(profile, assessmentData)) {
        setAssessmentData({
          ...stateRes,
          status: 'completed',
          current_stage: 'completed',
        });
        setError(null);
      } else {
        setAssessmentData(stateRes);
        setUncertainError('Backend state rechecked, but assessment is not confirmed yet. Please try confirming again.');
      }
    } catch {
      setUncertainError('Failed to verify backend status. Please try rechecking again.');
    } finally {
      setRechecking(false);
    }
  };

  // Action: Confirm Assessment
  const handleConfirmAssessment = async () => {
    if (confirming || !assessmentData?.assessment_id) return;
    const currentGen = activeGenRef.current;
    setConfirming(true);
    setError(null);
    setUncertainError(null);

    const activeUserId = userId || sessionStorage.getItem('matchlens_user_id');

    try {
      // POST /api/v1/assessment/{assessment_id}/confirm
      const confirmRes = await assessmentService.confirmAssessment(assessmentData.assessment_id);

      if (currentGen !== activeGenRef.current) return;

      // Authoritative verification: inspect actual confirmed profile or re-fetch profile
      let profile = (confirmRes && confirmRes.user_id === activeUserId && Array.isArray(confirmRes.scenario_responses))
        ? confirmRes
        : null;

      if (!profile) {
        try {
          profile = await profileService.getProfile(activeUserId);
        } catch {
          // Profile check failed
        }
      }

      if (isAssessmentPersistedInProfile(profile, assessmentData)) {
        setAssessmentData((prev) => ({
          ...prev,
          status: 'completed',
          current_stage: 'completed',
        }));
        setError(null);
      } else {
        setUncertainError(
          'Confirmation POST succeeded, but persisted scenario responses for this assessment could not be verified in your profile. Please recheck status.'
        );
      }
    } catch {
      if (currentGen !== activeGenRef.current) return;

      // Ambiguous error recovery check
      try {
        const profile = await profileService.getProfile(activeUserId);
        if (isAssessmentPersistedInProfile(profile, assessmentData)) {
          setAssessmentData((prev) => ({
            ...prev,
            status: 'completed',
            current_stage: 'completed',
          }));
          setError(null);
          return;
        }
      } catch {
        // Check failed
      }

      setUncertainError('A network or server error occurred during confirmation. Recheck status to verify.');
    } finally {
      if (currentGen === activeGenRef.current) {
        setConfirming(false);
      }
    }
  };

  // Render Loading State
  if (loading) {
    return (
      <div className="max-w-3xl mx-auto w-full flex-1 flex flex-col justify-center items-center py-16">
        <div className="w-12 h-12 border-4 border-[#F2C0B6] border-t-[#E07A5F] rounded-full animate-spin mb-4" />
        <p className="text-sm font-medium text-[#5C627A]">Loading scenario assessment...</p>
      </div>
    );
  }

  // Render Missing Confirmed Profile Guard
  if (!hasConfirmedProfile && !profileCheckFailed) {
    return (
      <div className="max-w-xl mx-auto w-full flex-1 flex flex-col justify-center items-center py-12">
        <Card className="p-8 text-center w-full shadow-sm">
          <div className="w-14 h-14 rounded-2xl bg-[#FDF0ED] border border-[#F2C0B6] text-[#E07A5F] flex items-center justify-center mx-auto mb-4">
            <ShieldAlert className="w-7 h-7" />
          </div>
          <Badge variant="rose" className="mb-3">
            Confirmed Profile Required
          </Badge>
          <h2 className="text-xl font-bold text-[#2B2D42] mb-2">Complete Profile Review First</h2>
          <p className="text-sm text-[#5C627A] mb-6 leading-relaxed">
            Scenario assessment evaluates relationship choices for reciprocal matching. You must complete conversational onboarding and explicitly confirm your profile traits first.
          </p>
          <div className="flex flex-col sm:flex-row justify-center gap-3">
            <Link to="/profile/review">
              <Button variant="primary" icon={ArrowRight}>
                Go to Profile Review
              </Button>
            </Link>
          </div>
        </Card>
      </div>
    );
  }

  // Render Expired Session or Startup Error
  if (error && !assessmentData) {
    return (
      <div className="max-w-xl mx-auto w-full flex-1 flex flex-col justify-center items-center py-12">
        <Card className="p-8 text-center w-full shadow-sm">
          <div className="w-14 h-14 rounded-2xl bg-[#FAF6F0] border border-[#E8E3DC] text-[#E07A5F] flex items-center justify-center mx-auto mb-4">
            <AlertCircle className="w-7 h-7" />
          </div>
          <h2 className="text-xl font-bold text-[#2B2D42] mb-2">
            {restorationFailed ? 'Assessment Restoration Failure' : 'Assessment Session Notice'}
          </h2>
          <p className="text-sm text-[#5C627A] mb-6 leading-relaxed">{error}</p>
          <div className="flex flex-col sm:flex-row justify-center gap-3">
            {restorationFailed && (
              <Button
                variant="primary"
                icon={RefreshCw}
                onClick={initializeAssessment}
                disabled={loading}
              >
                Retry Restoration
              </Button>
            )}
            <Button
              variant={restorationFailed ? 'secondary' : 'primary'}
              icon={restorationFailed ? undefined : RefreshCw}
              onClick={handleStartAssessment}
              disabled={submitting}
            >
              {submitting ? 'Starting New Assessment...' : 'Start New Assessment'}
            </Button>
          </div>
        </Card>
      </div>
    );
  }

  // Render Ready to Start State (no active assessment session created yet)
  if (!assessmentData) {
    return (
      <div className="max-w-2xl mx-auto w-full py-8 px-4 sm:px-6">
        <AssessmentHeader status="active" currentStage="start" userId={userId} />

        <Card className="p-8 md:p-10 text-center border-[#E8E3DC] shadow-sm">
          <div className="w-16 h-16 rounded-2xl bg-[#FDF0ED] border border-[#F2C0B6] text-[#E07A5F] flex items-center justify-center mx-auto mb-6">
            <Layers className="w-8 h-8" />
          </div>

          <h2 className="text-2xl font-bold text-[#2B2D42] mb-3 tracking-tight">
            Ready to Begin Assessment
          </h2>

          <p className="text-sm text-[#5C627A] max-w-md mx-auto mb-8 leading-relaxed">
            You will evaluate 3 core relationship decision scenarios. For each scenario, you will answer from two perspectives: your own behavior and your ideal partner.
          </p>

          <Button
            variant="primary"
            icon={ArrowRight}
            onClick={handleStartAssessment}
            disabled={submitting}
            className="py-3.5 px-8 shadow-md text-base"
          >
            {submitting ? 'Starting Assessment...' : 'Start Assessment'}
          </Button>
        </Card>
      </div>
    );
  }

  // Authoritative status & stage fields
  const status = assessmentData.status;
  const currentStage = assessmentData.current_stage;
  const isCompleted = status === 'completed' || currentStage === 'completed';
  const isReview = status === 'ready_for_review' || currentStage === 'review';

  return (
    <div className="max-w-3xl mx-auto w-full py-8 px-4 sm:px-6">
      <AssessmentHeader status={status} currentStage={currentStage} userId={userId} />

      {/* Persistent Error Banner */}
      {error && (
        <div className="mb-6 p-4 bg-[#FDF0ED] border border-[#F2C0B6] rounded-xl text-xs text-[#E07A5F] flex items-center justify-between gap-3">
          <div className="flex items-center gap-3">
            <AlertCircle className="w-5 h-5 shrink-0" />
            <span>{error}</span>
          </div>
          <Button variant="ghost" size="sm" onClick={() => setError(null)}>
            Dismiss
          </Button>
        </div>
      )}

      {uncertainError && (
        <div className="mb-6 p-4 bg-[#FAF6F0] border border-[#E8E3DC] rounded-xl text-xs text-[#5C627A] flex items-center justify-between gap-3">
          <div className="flex items-center gap-3">
            <AlertCircle className="w-5 h-5 text-[#E07A5F] shrink-0" />
            <span>{uncertainError}</span>
          </div>
          <Button variant="secondary" size="sm" icon={RefreshCw} onClick={handleRecheckStatus} disabled={rechecking}>
            {rechecking ? 'Checking...' : 'Recheck Status'}
          </Button>
        </div>
      )}

      {/* Progress Bar (Visible in active & review stages) */}
      {!isCompleted && (
        <ScenarioProgress progress={assessmentData.progress} currentStage={currentStage} />
      )}

      {/* Completed State View */}
      {isCompleted ? (
        <AssessmentCompletion onNavigateToMatches={() => navigate('/matches')} />
      ) : isReview ? (
        /* Review Screen */
        <ScenarioReview
          summaryData={assessmentData.summary_data || {}}
          selectedScenarioIds={assessmentData.selected_scenario_ids || []}
          confirming={confirming}
          onConfirmAssessment={handleConfirmAssessment}
          onCorrectResponse={handleCorrectResponse}
          correctingState={correctingState}
          isAlreadyCompleted={isCompleted}
          onNavigateToMatches={() => navigate('/matches')}
        />
      ) : (
        /* Active Scenario Question Stage */
        <>
          <ScenarioCard
            scenarioDefinition={assessmentData.scenario_definition}
            currentStage={currentStage}
          />

          <ScenarioResponseForm
            allowedOptions={assessmentData.allowed_options || []}
            optionDescriptions={assessmentData.scenario_definition?.option_descriptions || {}}
            unresolvedClarification={assessmentData.unresolved_clarification}
            submitting={submitting}
            onSubmitTurn={handleSubmitTurn}
          />
        </>
      )}

      {/* Navigation Footer */}
      <div className="mt-8 pt-6 border-t border-[#E8E3DC] flex items-center justify-between">
        <Link to="/profile/review">
          <Button variant="ghost" icon={RotateCcw}>
            Profile Review
          </Button>
        </Link>
      </div>
    </div>
  );
};

export default AssessmentPage;
</file>

<file path="frontend/src/pages/InterviewPage.jsx">
import { useState, useEffect, useRef, useCallback } from 'react';
import { useNavigate } from 'react-router-dom';
import { Sparkles, Loader2, AlertCircle, Compass } from 'lucide-react';
import { useWorkflow } from '../context/WorkflowContext';
import { interviewService } from '../services/interviewService';
import {
  ChatMessage,
  ChatComposer,
  InterviewProgress,
  InterviewHeader,
} from '../components/interview';
import { Card } from '../components/ui/Card';
import { Button } from '../components/ui/Button';

/**
 * Conversational AI Onboarding Interview Page.
 * Handles persistent session recovery, turn-by-turn processing, StrictMode deduplication,
 * and auto-scrolling chat history.
 */
export const InterviewPage = () => {
  const navigate = useNavigate();
  const { userId, sessionId, setSessionId, resetWorkflow } = useWorkflow();

  const [messages, setMessages] = useState([]);
  const [draftMessage, setDraftMessage] = useState('');
  const [status, setStatus] = useState('active');
  const [currentTopic, setCurrentTopic] = useState('basic_and_intention');
  const [progressPct, setProgressPct] = useState(0);
  const [completedTopics, setCompletedTopics] = useState([]);
  const [turnCount, setTurnCount] = useState(0);
  const [pendingConfirmations, setPendingConfirmations] = useState([]);
  const [sessionExpired, setSessionExpired] = useState(false);
  const [rejectionTarget, setRejectionTarget] = useState(null);

  const [isLoading, setIsLoading] = useState(false);
  const [isInitializing, setIsInitializing] = useState(true);
  const [isRestarting, setIsRestarting] = useState(false);
  const [error, setError] = useState(null);

  const messagesEndRef = useRef(null);
  const isMountedRef = useRef(false);
  const activeSessionIdRef = useRef(sessionId);
  const generationTokenRef = useRef(0);
  const activeRequestIdRef = useRef(0);

  useEffect(() => {
    activeSessionIdRef.current = sessionId;
  }, [sessionId]);

  // Auto-scroll to latest message
  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };

  useEffect(() => {
    scrollToBottom();
  }, [messages, isLoading]);

  // Session Initialization & Recovery
  const initSession = useCallback(async (forcedSessionId = undefined, token = undefined) => {
    const activeToken = token !== undefined ? token : ++generationTokenRef.current;
    
    setIsInitializing(true);
    setError(null);
    setSessionExpired(false);

    const targetSessionId = forcedSessionId !== undefined ? forcedSessionId : sessionId;

    try {
      if (targetSessionId) {
        // Attempt session recovery via GET /api/v1/interview/{sessionId}
        try {
          const stateData = await interviewService.getInterviewState(targetSessionId);
          
          // Guard against out-of-order session responses or outdated generation tokens
          if (generationTokenRef.current !== activeToken) {
            return;
          }

          setStatus(stateData.status);
          setCurrentTopic(stateData.current_topic);
          setTurnCount(stateData.turn_count || 0);
          setPendingConfirmations(stateData.pending_confirmations || []);

          if (stateData.progress) {
            setProgressPct(stateData.progress.percentage || 0);
            setCompletedTopics(stateData.progress.completed_topics || []);
          }

          // Restore conversation history if provided by backend
          if (stateData.conversation_history && stateData.conversation_history.length > 0) {
            const restoredConfs = stateData.pending_confirmations || [];
            const lastAssistantIdx = stateData.conversation_history.findLastIndex((m) => m.role === 'assistant');

            setMessages(
              stateData.conversation_history.map((msg, idx) => ({
                id: `hist_${idx}_${Date.now()}`,
                role: msg.role,
                content: msg.content,
                timestamp: msg.timestamp,
                pendingConfirmations: msg.pendingConfirmations || (idx === lastAssistantIdx && restoredConfs.length > 0 ? restoredConfs : []),
              }))
            );
          } else {
            // Display neutral system notice outside assistant-message model
            setMessages([
              {
                id: `sys_notice_${Date.now()}`,
                role: 'system_notice',
                content: 'Session restored. Detailed past conversation turns are unavailable.',
                timestamp: new Date().toISOString(),
              },
            ]);
          }
          return;
        } catch (recoverErr) {
          if (generationTokenRef.current !== activeToken) {
            return;
          }
          // If 404/not found or expired, do NOT auto-start a new session. Show session-expired state.
          if (recoverErr.status === 404 || (recoverErr.message && recoverErr.message.includes('not found'))) {
            setSessionId(null);
            setSessionExpired(true);
            return;
          } else {
            throw recoverErr;
          }
        }
      }

      // No active session or forced start: Start new interview
      const startRes = await interviewService.startInterview(userId);
      
      if (generationTokenRef.current !== activeToken) {
        return;
      }

      setSessionId(startRes.session_id);
      activeSessionIdRef.current = startRes.session_id;

      setStatus(startRes.interview_status || 'active');
      setCurrentTopic(startRes.current_topic || 'basic_and_intention');
      setTurnCount(1);
      setPendingConfirmations(startRes.pending_confirmations || []);

      if (startRes.progress) {
        setProgressPct(startRes.progress.percentage || 0);
        setCompletedTopics(startRes.progress.completed_topics || []);
      }

      setMessages([
        {
          id: `init_1_${Date.now()}`,
          role: 'assistant',
          content: startRes.assistant_message,
          timestamp: new Date().toISOString(),
        },
      ]);
    } catch (err) {
      if (generationTokenRef.current === activeToken) {
        setError(err.message || 'Failed to initialize interview session.');
      }
    } finally {
      if (generationTokenRef.current === activeToken) {
        setIsInitializing(false);
      }
    }
  }, [userId, sessionId, setSessionId]);

  // Mount effect with React StrictMode guard
  useEffect(() => {
    if (!isMountedRef.current) {
      isMountedRef.current = true;
      const initialToken = ++generationTokenRef.current;
      initSession(undefined, initialToken);
    }
  }, [initSession]);

  // Handle user turn submission
  const handleSendMessage = async (userText, retryMsgId = null) => {
    if (!userText.trim() || isLoading || isInitializing || isRestarting) return;
    const currentSessionId = activeSessionIdRef.current;
    if (!currentSessionId) return;

    const activeToken = generationTokenRef.current;
    const requestId = ++activeRequestIdRef.current;

    setError(null);
    setIsLoading(true);

    const userMsgId = retryMsgId || `user_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;

    if (!retryMsgId) {
      const newMsg = {
        id: userMsgId,
        role: 'user',
        content: userText,
        timestamp: new Date().toISOString(),
        status: 'pending',
      };
      setMessages((prev) => [...prev, newMsg]);
      setDraftMessage('');
    } else {
      setMessages((prev) =>
        prev.map((msg) => (msg.id === retryMsgId ? { ...msg, status: 'pending' } : msg))
      );
    }

    try {
      const turnRes = await interviewService.processTurn(currentSessionId, userText);

      if (
        generationTokenRef.current !== activeToken ||
        activeSessionIdRef.current !== currentSessionId ||
        activeRequestIdRef.current !== requestId
      ) {
        return;
      }

      setMessages((prev) =>
        prev.map((msg) => (msg.id === userMsgId ? { ...msg, status: 'delivered' } : msg))
      );

      setStatus(turnRes.interview_status);
      setCurrentTopic(turnRes.current_topic);
      setTurnCount((prev) => prev + 1);
      setPendingConfirmations(turnRes.pending_confirmations || []);
      setRejectionTarget(null);

      if (turnRes.progress) {
        setProgressPct(turnRes.progress.percentage || 0);
        setCompletedTopics(turnRes.progress.completed_topics || []);
      }

      const assistantMsg = {
        id: `asst_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
        role: 'assistant',
        content: turnRes.assistant_message,
        timestamp: new Date().toISOString(),
        newlyExtracted: turnRes.newly_extracted_fields || [],
        pendingConfirmations: turnRes.pending_confirmations || [],
      };

      setMessages((prev) => [...prev, assistantMsg]);
    } catch (err) {
      if (
        generationTokenRef.current !== activeToken ||
        activeSessionIdRef.current !== currentSessionId ||
        activeRequestIdRef.current !== requestId
      ) {
        return;
      }

      // Ambiguous network failure check: try to recover state before marking failed
      if (err.status === 0 || err.status === 408) {
        try {
          const recoveredState = await interviewService.getInterviewState(currentSessionId);
          if (
            generationTokenRef.current === activeToken &&
            activeSessionIdRef.current === currentSessionId &&
            recoveredState.turn_count > turnCount
          ) {
            setStatus(recoveredState.status);
            setCurrentTopic(recoveredState.current_topic);
            setTurnCount(recoveredState.turn_count);
            setPendingConfirmations(recoveredState.pending_confirmations || []);
            if (recoveredState.progress) {
              setProgressPct(recoveredState.progress.percentage || 0);
              setCompletedTopics(recoveredState.progress.completed_topics || []);
            }
            if (recoveredState.conversation_history && recoveredState.conversation_history.length > 0) {
              const restoredConfs = recoveredState.pending_confirmations || [];
              const lastAssistantIdx = recoveredState.conversation_history.findLastIndex((m) => m.role === 'assistant');
              setMessages(
                recoveredState.conversation_history.map((msg, idx) => ({
                  id: `hist_${idx}_${Date.now()}`,
                  role: msg.role,
                  content: msg.content,
                  timestamp: msg.timestamp,
                  pendingConfirmations: msg.pendingConfirmations || (idx === lastAssistantIdx && restoredConfs.length > 0 ? restoredConfs : []),
                }))
              );
            }
            setIsLoading(false);
            return;
          }
        } catch {
          // Fall through to mark failed
        }
      }

      setMessages((prev) =>
        prev.map((msg) => (msg.id === userMsgId ? { ...msg, status: 'failed' } : msg))
      );
      setDraftMessage(userText);
      setError(err.message || 'Failed to send message. Please try again.');
    } finally {
      if (generationTokenRef.current === activeToken && activeRequestIdRef.current === requestId) {
        setIsLoading(false);
      }
    }
  };

  // Handle early finish trigger
  const handleEarlyFinish = async () => {
    await handleSendMessage('/finish');
  };

  // Handle fresh restart (Genuinely new session without setTimeout closures)
  const handleStartFresh = async () => {
    if (isRestarting) return;
    setIsRestarting(true);
    setError(null);

    const token = ++generationTokenRef.current;

    resetWorkflow();
    setSessionId(null);
    activeSessionIdRef.current = null;
    setMessages([]);
    setStatus('active');
    setCurrentTopic('basic_and_intention');
    setProgressPct(0);
    setCompletedTopics([]);
    setTurnCount(0);
    setPendingConfirmations([]);
    setSessionExpired(false);
    setDraftMessage('');
    setRejectionTarget(null);

    try {
      await initSession(null, token);
    } finally {
      if (generationTokenRef.current === token) {
        setIsRestarting(false);
      }
    }
  };

  const isFinished = status === 'ready_for_review' || status === 'completed';

  return (
    <div className="flex-1 flex flex-col max-w-4xl mx-auto w-full">
      {/* Top Section Progress Bar */}
      <InterviewProgress
        percentage={progressPct}
        currentTopic={currentTopic}
        completedTopics={completedTopics}
      />

      {/* Main Chat Container Card */}
      <Card className="flex-1 flex flex-col min-h-[500px] max-h-[70vh] p-4 sm:p-6 shadow-xs relative overflow-hidden">
        {/* Header Bar */}
        <InterviewHeader
          status={status}
          turnCount={turnCount}
          onEarlyFinish={handleEarlyFinish}
          onStartNewSession={handleStartFresh}
          isFinished={isFinished}
        />

        {/* Conversation Message Scroll Window */}
        <div className="flex-1 overflow-y-auto px-1 py-2 space-y-4">
          {sessionExpired ? (
            <div className="h-full flex flex-col items-center justify-center text-center p-8 text-[#5C627A]">
              <AlertCircle className="w-8 h-8 text-[#E07A5F] mb-3" />
              <h3 className="text-base font-bold text-[#2B2D42] mb-1">Session Expired or Not Found</h3>
              <p className="text-xs text-[#5C627A] mb-4 max-w-sm">
                Your previous interview session is no longer active. You can start a new interview session below.
              </p>
              <Button variant="primary" size="md" onClick={handleStartFresh}>
                Start New Interview
              </Button>
            </div>
          ) : isInitializing ? (
            <div className="h-full flex flex-col items-center justify-center text-center p-8 text-[#5C627A]">
              <Loader2 className="w-8 h-8 animate-spin text-[#E07A5F] mb-3" />
              <p className="text-sm font-medium">Initializing session...</p>
            </div>
          ) : messages.length === 0 ? (
            <div className="h-full flex flex-col items-center justify-center text-center p-8 text-[#5C627A]">
              <Compass className="w-8 h-8 text-[#E07A5F] mb-3" />
              <p className="text-sm font-medium">Your interview is ready to begin.</p>
            </div>
          ) : (
            messages.map((msg, index) => {
              // Find if this is the latest assistant message with pending confirmations from active backend state
              const isLatestAssistantWithConfirmation =
                msg.role === 'assistant' &&
                msg.pendingConfirmations &&
                msg.pendingConfirmations.length > 0 &&
                pendingConfirmations.length > 0 &&
                index === messages.findLastIndex((m) => m.role === 'assistant' && m.pendingConfirmations && m.pendingConfirmations.length > 0);

              return (
                <div key={msg.id || index} className="flex flex-col">
                  <ChatMessage
                    role={msg.role}
                    content={msg.content}
                    timestamp={msg.timestamp}
                    newlyExtracted={msg.newlyExtracted}
                    pendingConfirmations={msg.pendingConfirmations}
                    onConfirmClick={handleSendMessage}
                    onRejectClick={(conf) => {
                      setRejectionTarget(conf);
                      setDraftMessage(`No, actually for ${conf.field_name}: `);
                    }}
                    isInteractive={isLatestAssistantWithConfirmation && !isFinished}
                    isLoading={isLoading}
                  />
                  {msg.status === 'failed' && (
                    <div className="self-end text-xs text-red-500 mt-1 flex items-center gap-2">
                      <span>Failed to send.</span>
                      <button
                        disabled={isLoading}
                        onClick={() => handleSendMessage(msg.content, msg.id)}
                        className="font-semibold underline hover:text-red-700 cursor-pointer disabled:opacity-50"
                      >
                        Retry
                      </button>
                    </div>
                  )}
                </div>
              );
            })
          )}

          {/* Thinking Pulse Indicator */}
          {isLoading && (
            <div className="flex gap-3 my-3">
              <div className="w-8 h-8 rounded-xl bg-[#FAF6F0] text-[#E07A5F] border border-[#E8E3DC] flex items-center justify-center shrink-0">
                <Sparkles className="w-4 h-4 animate-pulse" />
              </div>
              <div className="bg-white border border-[#E8E3DC] px-4 py-3 rounded-2xl rounded-tl-xs shadow-2xs text-xs text-[#5C627A] flex items-center gap-2">
                <Loader2 className="w-3.5 h-3.5 animate-spin text-[#E07A5F]" />
                <span>MatchLens is processing your response...</span>
              </div>
            </div>
          )}

          <div ref={messagesEndRef} />
        </div>

        {/* Global Error Banner */}
        {error && (
          <div className="mt-3 p-3 bg-red-50 border border-red-200 rounded-xl text-xs text-red-600 flex items-center justify-between gap-2">
            <div className="flex items-center gap-2">
              <AlertCircle className="w-4 h-4 shrink-0" />
              <span>{error}</span>
            </div>
            <button
              onClick={() => setError(null)}
              className="text-red-500 font-semibold hover:underline cursor-pointer"
            >
              Dismiss
            </button>
          </div>
        )}

        {/* Ready For Review Completion Overlay */}
        {isFinished ? (
          <div className="mt-4 p-5 bg-[#FDF0ED] border border-[#F2C0B6] rounded-2xl text-center flex flex-col items-center">
            <h3 className="text-base font-bold text-[#2B2D42] mb-1">
              {status === 'completed' ? 'Profile Confirmed!' : 'Draft Profile Ready!'}
            </h3>
            <p className="text-xs text-[#5C627A] mb-4 max-w-md">
              {status === 'completed'
                ? 'Your interview responses are finalized. You can review your confirmed profile.'
                : "You've provided sufficient details for your draft profile. Click below to review and verify your preferences."}
            </p>
            <Button
              variant="primary"
              size="md"
              onClick={() => navigate('/profile/review')}
              className="px-6 py-2.5"
            >
              Review My Profile
            </Button>
          </div>
        ) : (
          /* Fixed Message Composer */
          <div className="mt-4 pt-2">
            {rejectionTarget && (
              <div className="mb-2 p-2 bg-[#FAF6F0] border border-[#F2C0B6] rounded-xl text-xs text-[#5C627A] flex items-center justify-between">
                <span>
                  Providing correction for <strong className="text-[#2B2D42]">{rejectionTarget.field_name}</strong>
                </span>
                <button
                  onClick={() => {
                    setRejectionTarget(null);
                    setDraftMessage('');
                  }}
                  className="text-xs text-[#E07A5F] hover:underline font-semibold"
                >
                  Cancel
                </button>
              </div>
            )}
            <ChatComposer
              onSendMessage={(txt) => handleSendMessage(txt)}
              isLoading={isLoading}
              disabled={isInitializing || isRestarting || isFinished || sessionExpired}
              initialValue={draftMessage}
              placeholder="Type your response... (Press Enter to send)"
            />
          </div>
        )}
      </Card>
    </div>
  );
};

export default InterviewPage;
