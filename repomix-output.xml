<file path="frontend/src/components/interview/ChatMessage.jsx">
import { HeartHandshake, User, CheckCircle2, AlertCircle } from 'lucide-react';
import { Badge } from '../ui/Badge';

/**
 * Reusable chat message bubble component.
 * Distinguishes user messages (right-aligned, soft rose) and assistant messages (left-aligned, warm card).
 */
export const ChatMessage = ({
  role = 'assistant',
  content = '',
  timestamp,
  newlyExtracted = [],
  pendingConfirmations = [],
  onConfirmClick,
  onRejectClick,
  isInteractive = false,
  isLoading = false,
}) => {
  if (role === 'system_notice') {
    return (
      <div className="my-3 w-full flex justify-center">
        <div className="bg-[#FAF6F0] border border-[#E8E3DC] text-[#5C627A] px-4 py-2.5 rounded-xl text-xs font-medium text-center max-w-md shadow-2xs">
          {content}
        </div>
      </div>
    );
  }

  const isUser = role === 'user';

  const formattedTime = timestamp
    ? new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    : null;

  return (
    <div className={`flex gap-3 my-3 w-full ${isUser ? 'flex-row-reverse' : 'flex-row'}`}>
      {/* Avatar Icon */}
      <div
        className={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 text-xs font-semibold shadow-2xs ${
          isUser
            ? 'bg-[#E07A5F] text-white'
            : 'bg-[#FAF6F0] text-[#E07A5F] border border-[#E8E3DC]'
        }`}
      >
        {isUser ? <User className="w-4 h-4" /> : <HeartHandshake className="w-4 h-4" />}
      </div>

      {/* Message Content Bubble */}
      <div className={`flex flex-col max-w-[82%] sm:max-w-[75%] ${isUser ? 'items-end' : 'items-start'}`}>
        <div
          className={`px-4 py-3 rounded-2xl text-sm leading-relaxed ${
            isUser
              ? 'bg-[#E07A5F] text-white rounded-tr-xs shadow-xs font-normal'
              : 'bg-white text-[#2B2D42] border border-[#E8E3DC] rounded-tl-xs shadow-2xs'
          }`}
        >
          <p className="whitespace-pre-wrap break-words">{content}</p>

          {/* Newly Extracted Field Tags */}
          {!isUser && newlyExtracted && newlyExtracted.length > 0 && (
            <div className="mt-3 pt-2.5 border-t border-[#E8E3DC] flex flex-wrap gap-1.5 items-center">
              <span className="text-[11px] font-semibold text-[#5C627A] flex items-center gap-1">
                <CheckCircle2 className="w-3 h-3 text-[#2A7B4C]" />
                Captured:
              </span>
              {newlyExtracted.map((field, idx) => (
                <Badge key={idx} variant="success" size="sm">
                  {field.replace(/^(attributes|expectations|dealbreakers)\./, '')}
                </Badge>
              ))}
            </div>
          )}

          {/* Pending Confirmations Prompt Card */}
          {!isUser && pendingConfirmations && pendingConfirmations.length > 0 && (
            <div className="mt-3 p-3 bg-[#FAF6F0] rounded-xl border border-[#F2C0B6] flex flex-col gap-2">
              <div className="flex items-center gap-1.5 text-xs font-semibold text-[#E07A5F]">
                <AlertCircle className="w-4 h-4" />
                <span>Confirmation Requested</span>
              </div>
              <p className="text-xs text-[#5C627A]">
                {pendingConfirmations[0].reasoning || 'Please confirm if this proposed value is accurate:'}
              </p>
              <div className="text-xs font-medium bg-white px-3 py-1.5 rounded-lg border border-[#E8E3DC] text-[#2B2D42]">
                <span className="font-semibold">{pendingConfirmations[0].field_name}:</span>{' '}
                {String(pendingConfirmations[0].proposed_value)}
              </div>
              {onConfirmClick && isInteractive ? (
                <div className="flex gap-2 mt-1">
                  <button
                    type="button"
                    disabled={isLoading}
                    onClick={() => onConfirmClick('Yes, that is correct.')}
                    className="flex-1 py-1 px-2.5 bg-[#E07A5F] hover:bg-[#C85A3F] text-white rounded-lg text-xs font-semibold transition-colors cursor-pointer disabled:opacity-50"
                  >
                    Yes, Confirm
                  </button>
                  <button
                    type="button"
                    disabled={isLoading}
                    onClick={() => {
                      if (onRejectClick) {
                        onRejectClick(pendingConfirmations[0]);
                      } else {
                        onConfirmClick('No, that is not correct.');
                      }
                    }}
                    className="flex-1 py-1 px-2.5 bg-white hover:bg-[#F2ECE1] text-[#2B2D42] border border-[#E8E3DC] rounded-lg text-xs font-semibold transition-colors cursor-pointer disabled:opacity-50"
                  >
                    No, Correct
                  </button>
                </div>
              ) : (
                <div className="text-[11px] font-medium text-[#A0A4B8] italic mt-1">
                  Confirmation recorded
                </div>
              )}
            </div>
          )}
        </div>

        {/* Timestamp */}
        {formattedTime && (
          <span className="text-[10px] text-[#A0A4B8] mt-1 px-1">{formattedTime}</span>
        )}
      </div>
    </div>
  );
};

export default ChatMessage;
</file>

<file path="frontend/src/components/matches/EvidenceCoverage.jsx">
import React from 'react';
import { Info, AlertTriangle, ShieldCheck, HelpCircle } from 'lucide-react';

/**
 * Renders backend-provided evidence coverage metric visually separate from compatibility scores.
 * Safely handles missing/null coverage metrics without labeling missing data as "High Coverage".
 */
export const EvidenceCoverage = ({ coverage = null, isLowCoverage = false }) => {
  const hasValidMetric =
    coverage !== null &&
    coverage !== undefined &&
    coverage !== '' &&
    (typeof coverage === 'number' || (typeof coverage === 'string' && coverage.trim() !== '')) &&
    !isNaN(Number(coverage));
  const roundedCoverage = hasValidMetric ? Math.max(0, Math.min(100, Math.round(coverage))) : null;

  return (
    <div className="bg-[#FAF6F0] border border-[#E8E3DC] rounded-xl p-4 mb-5">
      <div className="flex items-start gap-3">
        {!hasValidMetric ? (
          <div className="p-2 rounded-lg bg-white border border-[#E8E3DC] text-[#8D99AE] shrink-0 mt-0.5">
            <HelpCircle className="w-4 h-4" />
          </div>
        ) : isLowCoverage ? (
          <div className="p-2 rounded-lg bg-[#FDF0ED] border border-[#F2C0B6] text-[#E07A5F] shrink-0 mt-0.5">
            <AlertTriangle className="w-4 h-4" />
          </div>
        ) : (
          <div className="p-2 rounded-lg bg-[#F4F7F9] border border-[#BCD0E2] text-[#3D5A80] shrink-0 mt-0.5">
            <ShieldCheck className="w-4 h-4" />
          </div>
        )}

        <div className="flex-1">
          <div className="flex items-center justify-between mb-1">
            <span className="text-xs font-semibold text-[#2B2D42] flex items-center gap-1.5">
              Evidence Coverage
              {hasValidMetric && <span className="text-xs font-normal text-[#5C627A]">({roundedCoverage}%)</span>}
            </span>
            <span
              className={`text-xs font-bold px-2 py-0.5 rounded-full border ${
                !hasValidMetric
                  ? 'bg-white border-[#E8E3DC] text-[#5C627A]'
                  : isLowCoverage
                  ? 'bg-[#FDF0ED] border-[#F2C0B6] text-[#E07A5F]'
                  : 'bg-[#F4F7F9] border-[#BCD0E2] text-[#3D5A80]'
              }`}
            >
              {!hasValidMetric ? 'Evidence unavailable' : isLowCoverage ? 'Limited Data' : 'High Coverage'}
            </span>
          </div>

          <p className="text-xs text-[#5C627A] mb-2 leading-relaxed">
            Evidence coverage shows how much information was available to support this compatibility assessment.
          </p>

          {hasValidMetric ? (
            <div className="w-full bg-white h-2 rounded-full overflow-hidden border border-[#E8E3DC]">
              <div
                className={`h-full rounded-full transition-all duration-500 ${
                  isLowCoverage ? 'bg-[#E07A5F]' : 'bg-[#3D5A80]'
                }`}
                style={{ width: `${roundedCoverage}%` }}
                role="progressbar"
                aria-valuenow={roundedCoverage}
                aria-valuemin={0}
                aria-valuemax={100}
              />
            </div>
          ) : (
            <p className="text-xs text-[#8D99AE] italic">
              No evidence coverage metric was provided for this match evaluation.
            </p>
          )}

          {hasValidMetric && isLowCoverage && (
            <p className="text-xs text-[#E07A5F] mt-2 flex items-center gap-1 font-medium">
              <Info className="w-3.5 h-3.5 shrink-0" />
              This compatibility index has limited underlying evidence. Interpret with appropriate context.
            </p>
          )}
        </div>
      </div>
    </div>
  );
};

export default EvidenceCoverage;
</file>

